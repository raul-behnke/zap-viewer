# ---- Instância ----
# Nome do projeto no Docker: zap-<cliente>. Separa volumes de outras instâncias.
COMPOSE_PROJECT_NAME=zap-cliente
# Porta da API em localhost. A skill usa http://localhost:<ZAP_PORT>.
ZAP_PORT=8000

# ---- API própria ----
MEDIA_RETENTION_DAYS=30
WAHA_SESSION=default
# chave em texto puro que a API envia pro WAHA no header X-Api-Key
WAHA_API_KEY_PLAIN=troque-esta-chave-tambem

# ---- WAHA ----
WHATSAPP_DEFAULT_ENGINE=GOWS
# imagem do WAHA: default (gows) é amd64, serve pra VPS. Em Mac Apple Silicon
# (arm64) descomentar e usar devlikeapro/waha:gows-arm
#WAHA_IMAGE=devlikeapro/waha:gows-arm
# hash sha512 de WAHA_API_KEY_PLAIN:
#   printf '%s' "$WAHA_API_KEY_PLAIN" | shasum -a 512 | cut -d' ' -f1
WAHA_API_KEY=sha512:COLE_O_HASH_AQUI
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=troque
WHATSAPP_HOOK_URL=http://api:8000/webhook/waha
WHATSAPP_HOOK_EVENTS=message.any,message.ack,message.reaction,message.edited,message.revoked,session.status
WHATSAPP_HOOK_HMAC_KEY=troque-este-segredo
# 0 = WAHA nunca apaga mídia; quem apaga é a lifecycle rule do R2
WHATSAPP_FILES_LIFETIME=0

# ---- History sync (negociado no pareamento; mudar exige novo QR) ----
WAHA_GOWS_DEVICE_REQUIRE_FULL_SYNC=true
WAHA_GOWS_DEVICE_HISTORY_SYNC_FULL_SYNC_DAYS_LIMIT=365
WAHA_GOWS_DEVICE_HISTORY_SYNC_FULL_SYNC_SIZE_MB_LIMIT=512
WAHA_GOWS_DEVICE_HISTORY_SYNC_STORAGE_QUOTA_MB=1024
WAHA_GOWS_DEVICE_HISTORY_SYNC_SUPPORT_GROUP_HISTORY=true
WAHA_GOWS_DEVICE_HISTORY_SYNC_ON_DEMAND_READY=true

# ---- Mídia no Cloudflare R2 ----
# Variáveis confirmadas contra o .env.example oficial do WAHA
# (https://github.com/devlikeapro/waha) e a doc de storages
# (https://waha.devlike.pro/docs/how-to/storages/). Descomentar todas as
# WAHA_S3_* pra mover a mídia do disco local do container pro R2. Ver
# "Mover a mídia pro Cloudflare R2" no README pro passo a passo completo
# (criar bucket, lifecycle rule, etc).
#WAHA_MEDIA_STORAGE=S3
#WAHA_S3_ENDPOINT=https://SEU_ACCOUNT_ID.r2.cloudflarestorage.com
#WAHA_S3_REGION=auto
#WAHA_S3_BUCKET=zap-media
#WAHA_S3_ACCESS_KEY_ID=
#WAHA_S3_SECRET_ACCESS_KEY=
#WAHA_S3_FORCE_PATH_STYLE=True
#WAHA_S3_PROXY_FILES=True
